# ARCHAEO-SCAN API Keys
# Copy this to .env and fill in your keys

# Copernicus Data Space (Sentinel-2 imagery)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# USGS EarthExplorer (terrain, LiDAR)
USGS_USERNAME=
USGS_PASSWORD=

# Anthropic (NLP document processing)
ANTHROPIC_API_KEY=

# Mapbox (atlas frontend, optional - can use MapLibre instead)
MAPBOX_ACCESS_TOKEN=
